{
  "name": "n8n-nodes-venmo",
  "version": "0.1.0",
  "description": "Unofficial Venmo API client and n8n nodes: sign in with email + SMS 2FA, send and request payments, read transactions.",
  "license": "MIT",
  "author": {
    "name": "JonBons",
    "email": "me@mattgraham.me"
  },
  "homepage": "https://github.com/JonBons/n8n-nodes-venmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonBons/n8n-nodes-venmo.git"
  },
  "bugs": {
    "url": "https://github.com/JonBons/n8n-nodes-venmo/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "venmo",
    "payments"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VenmoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Venmo/Venmo.node.js",
      "dist/nodes/Venmo/VenmoSignIn.node.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^2.49.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
